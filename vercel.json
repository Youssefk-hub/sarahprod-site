{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/pro/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/dates-de-tournee",
      "destination": "/#dates",
      "permanent": true
    },
    {
      "source": "/historique",
      "destination": "/#historique",
      "permanent": true
    },
    {
      "source": "/spectacle/:slug/",
      "destination": "/spectacle/:slug",
      "permanent": true
    },
    {
      "source": "/historique/:slug",
      "destination": "/#historique",
      "permanent": true
    }
  ]
}
